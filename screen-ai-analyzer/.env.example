# Copy to .env and fill in the keys you actually have.
# .env is git-ignored; never commit real keys.

# --- one key is enough ----------------------------------------------------

# OpenRouter: a single key can serve both a vision model (Gemini) and a text
# model (DeepSeek). Recommended if you only want one account/budget.
OPENROUTER_API_KEY=
# Models tried in order: a vision model first, a text model for the OCR fallback.
OPENROUTER_MODELS=google/gemini-2.5-flash,deepseek/deepseek-chat

# Google AI Studio (direct Gemini Vision access)
GEMINI_API_KEY=

# DeepSeek direct. deepseek-chat / deepseek-reasoner are text-only, so the app
# OCRs the screenshot locally and sends only the text.
DEEPSEEK_API_KEY=

# --- optional extra vision providers --------------------------------------

OPENAI_API_KEY=
# OPENAI_MODEL is taken from the settings file; default: gpt-4o-mini

# Any other OpenAI-compatible endpoint (vLLM, Ollama, LM Studio, LiteLLM…)
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# --- capability overrides (rarely needed) ---------------------------------
# Comma separated model ids to force-treat as vision capable, per family.
# GEMINI_VISION_MODELS=
# OPENAI_VISION_MODELS=
# OPENROUTER_VISION_MODELS=
# DEEPSEEK_VISION_MODELS=
# CUSTOM_VISION_MODELS=
